DATABASE_URL=postgresql://instant:instant@localhost:5432/instant_discount
REDIS_URL=redis://localhost:6379
PORT=3000
# Pepper used to hash acquirer card tokens: HMAC-SHA256(CARD_TOKEN_PEPPER, token)
CARD_TOKEN_PEPPER=dev-pepper-change-me
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts acquirer HMAC secrets at rest.
# DEV ONLY value below — never use it outside local development.
SECRETS_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
RESERVATION_TTL_SECONDS=600

# --- Admin / web app ---
WEB_BASE_URL=http://localhost:3001
# Google OAuth client id for staff SSO; only @GOOGLE_HOSTED_DOMAIN accounts can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=waffarha.com
# Created as ADMIN on startup (comma-separated).
BOOTSTRAP_ADMIN_EMAILS=
# Local development only: sign in as any registered user without Google.
DEV_LOGIN=true
COOKIE_SECURE=false
# smtp://user:pass@host:587 — unset means emails are printed to the log.
SMTP_URL=
SLACK_WEBHOOK_URL=
