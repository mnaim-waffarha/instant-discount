    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "redoc": "2.5.0",
    "supertest": "^7.0.0",
