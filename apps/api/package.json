    "@instant-discount/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.2",
