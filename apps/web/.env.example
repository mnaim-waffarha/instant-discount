# Where the Nest API runs; /api/* is proxied there (server-side only).
API_URL=http://localhost:3000
# Google OAuth client id for staff sign-in (must match the API's GOOGLE_CLIENT_ID). Build-time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Shows the development sign-in form. Local development only; the API must also set DEV_LOGIN=true. Build-time.
NEXT_PUBLIC_DEV_LOGIN=false
