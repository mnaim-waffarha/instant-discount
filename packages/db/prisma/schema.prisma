// Instant Discount — core schema.
// Money is always integer minor units (BigInt), percentages are basis points.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Country {
  EG
  SA
}

enum Currency {
  EGP
  SAR
}

enum CardScheme {
  VISA
  MASTERCARD
  MEEZA
  MADA
  AMEX
}

enum PartnerType {
  BANK
  MERCHANT
  WAFFARHA
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
}

enum DiscountType {
  PERCENT
  FIXED
  TIERED
}

enum LimitPeriod {
  DAY
  WEEK
  CAMPAIGN
}

enum RedemptionStatus {
  RESERVED
  CONFIRMED
  RELEASED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RedemptionEventType {
  RESERVED
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum SettlementMode {
  // Waffarha invoices external funders and pays the merchant their shares.
  WAFFARHA_COLLECTS
  // Funders settle with the merchant directly; the system issues statements only.
  DIRECT
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
}

enum UserRole {
  ADMIN
  CAMPAIGN_MANAGER
  APPROVER
  FINANCE
  VIEWER
  PARTNER_USER
}

model Partner {
  id           String      @id @default(uuid())
  name         String
  nameAr       String?
  type         PartnerType
  country      Country
  taxNumber    String?
  billingEmail String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  merchants Merchant[]
  fundings  CampaignFunding[]
  invoices  Invoice[]
  users     User[]
}

model Merchant {
  id        String   @id @default(uuid())
  // A merchant is always backed by a MERCHANT partner (for funding and invoicing).
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  name      String
  nameAr    String?
  country   Country
  mcc       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  terminals Terminal[]
}

model Branch {
  id         String   @id @default(uuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  name       String
  city       String?
  createdAt  DateTime @default(now())

  terminals Terminal[]
}

model Terminal {
  id                 String   @id @default(uuid())
  acquirerId         String
  acquirer           Acquirer @relation(fields: [acquirerId], references: [id])
  // Terminal id as known by the acquirer (TID).
  externalTerminalId String
  merchantId         String
  merchant           Merchant @relation(fields: [merchantId], references: [id])
  branchId           String?
  branch             Branch?  @relation(fields: [branchId], references: [id])
  // Overrides the merchant MCC when set.
  mcc                String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  redemptions Redemption[]

  @@unique([acquirerId, externalTerminalId])
}

model Acquirer {
  id              String   @id @default(uuid())
  name            String
  country         Country
  apiKeyId        String   @unique
  // Encrypted at rest by the application (KMS/vault), never returned by the API.
  hmacSecretEnc   String
  certFingerprint String?
  ipAllowlist     String[]
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  terminals   Terminal[]
  redemptions Redemption[]
}

model Campaign {
  id               String         @id @default(uuid())
  name             String
  nameAr           String?
  description      String?
  status           CampaignStatus @default(DRAFT)
  version          Int            @default(1)
  priority         Int            @default(0)
  country          Country
  currency         Currency
  timezone         String
  startAt          DateTime
  endAt            DateTime
  discountType     DiscountType
  // Matches rules-engine DiscountConfig.
  discountConfig   Json
  // Matches rules-engine Targeting.
  targeting        Json
  // Matches rules-engine ScheduleWindow[]; null = always.
  schedule         Json?
  displayMessage   String?
  displayMessageAr String?

  // Limits — null means unlimited.
  totalBudgetMinor      BigInt?
  maxUniqueCards        Int?
  dailyBudgetMinor      BigInt?
  dailyRedemptionLimit  Int?
  perCardMaxCount       Int?
  perCardMaxAmountMinor BigInt?
  perCardPeriod         LimitPeriod?

  settlementMode   SettlementMode @default(WAFFARHA_COLLECTS)
  // Pause automatically when a fraud alert points at this campaign.
  autoPauseOnFraud Boolean        @default(false)

  createdById     String?
  updatedById     String?
  submittedById   String?
  submittedAt     DateTime?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  pausedAt        DateTime?
  // Proposed edits to a campaign that is already approved; applied on approval.
  pendingChanges  Json?
  pendingById     String?
  pendingAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fundings    CampaignFunding[]
  versions    CampaignVersion[]
  redemptions Redemption[]

  @@index([status, country, startAt, endAt])
}

// Immutable snapshot of each approved version; redemptions reference the version they ran under.
model CampaignVersion {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  version    Int
  snapshot   Json
  createdAt  DateTime @default(now())

  @@unique([campaignId, version])
}

model CampaignFunding {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id])
  // Share of each discount in bps; all shares of a campaign sum to 10000.
  shareBps   Int

  @@unique([campaignId, partnerId])
}

model Redemption {
  id                    String           @id @default(uuid())
  acquirerId            String
  acquirer              Acquirer         @relation(fields: [acquirerId], references: [id])
  idempotencyKey        String
  acquirerTxnRef        String
  campaignId            String
  campaign              Campaign         @relation(fields: [campaignId], references: [id])
  campaignVersion       Int
  terminalId            String
  terminal              Terminal         @relation(fields: [terminalId], references: [id])
  // HMAC-SHA256(pepper, acquirer card token). The raw token is never stored.
  cardTokenHash         String
  bin                   String
  scheme                CardScheme
  currency              Currency
  originalAmountMinor   BigInt
  discountMinor         BigInt
  finalAmountMinor      BigInt
  refundedDiscountMinor BigInt           @default(0)
  // Portion of finalAmount (what the customer paid) refunded so far.
  refundedAmountMinor   BigInt           @default(0)
  // [{ partnerId, shareBps, amountMinor }] captured at reservation time.
  fundingSnapshot       Json
  // Period bucket keys used for the Redis counters, needed to release them exactly.
  counterKeys           Json
  status                RedemptionStatus @default(RESERVED)
  authCode              String?
  expiresAt             DateTime
  confirmedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  events RedemptionEvent[]

  @@unique([acquirerId, idempotencyKey])
  @@index([acquirerId, acquirerTxnRef])
  @@index([campaignId, status])
  @@index([status, expiresAt])
  @@index([cardTokenHash])
}

// Append-only ledger of every state change.
model RedemptionEvent {
  id                 String              @id @default(uuid())
  redemptionId       String
  redemption         Redemption          @relation(fields: [redemptionId], references: [id])
  type               RedemptionEventType
  // Signed change in discount (negative for cancel/refund).
  discountDeltaMinor BigInt
  amountMinor        BigInt?
  payload            Json?
  createdAt          DateTime            @default(now())
  // Set once the settlement ledger has processed this event.
  ledgerProcessedAt  DateTime?

  @@index([redemptionId])
  @@index([ledgerProcessedAt, type])
}

// Every inquiry, including "no discount", for analytics and support. Partition monthly in production.
model InquiryLog {
  id             String   @id @default(uuid())
  acquirerId     String
  terminalId     String?
  acquirerTxnRef String
  bin            String
  // Hashed card token (same hash as redemptions), for velocity and fraud signals.
  cardTokenHash  String?
  amountMinor    BigInt
  currency       Currency
  eligible       Boolean
  campaignId     String?
  redemptionId   String?
  // Reason code when not eligible, or per-campaign rejection summary.
  reason         String?
  details        Json?
  latencyMs      Int
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([campaignId, createdAt])
  @@index([cardTokenHash, createdAt])
  @@index([terminalId, createdAt])
}

enum DocumentType {
  // A funder (e.g. a bank) owes Waffarha its share (WAFFARHA_COLLECTS campaigns). VAT applies.
  INVOICE
  // Waffarha owes the merchant the funders' shares (WAFFARHA_COLLECTS campaigns).
  PAYOUT_STATEMENT
  // DIRECT campaigns: who owes whom, settled outside Waffarha.
  STATEMENT
}

enum DocumentLineKind {
  // The document's partner funded this much discount (it owes it).
  FUNDED_SHARE
  // A funder owes the document's partner (the merchant) this much.
  OWED_BY_FUNDER
  // The merchant's own contribution; informational, not payable.
  OWN_CONTRIBUTION
}

// One partner's share of one redemption event: +share on confirmation, -share on a
// refund or a cancel after confirmation. Derived from RedemptionEvent; idempotent per event.
model SettlementEntry {
  id                 String         @id @default(uuid())
  redemptionEventId  String
  redemptionId       String
  campaignId         String
  settlementMode     SettlementMode
  // The funder whose share this is.
  partnerId          String
  partnerType        PartnerType
  // The merchant partner whose terminal took the payment.
  merchantPartnerId  String
  country            Country
  currency           Currency
  // Signed, minor units.
  amountMinor        BigInt
  // +1 for a confirmation, -1 for a full reversal, 0 for a partial refund (count unchanged).
  countDelta         Int
  eventAt            DateTime
  // Document of the funder side (INVOICE, or STATEMENT in DIRECT mode).
  funderDocumentId   String?
  // Document of the merchant side (PAYOUT_STATEMENT, or STATEMENT in DIRECT mode).
  merchantDocumentId String?
  createdAt          DateTime       @default(now())

  @@unique([redemptionEventId, partnerId])
  @@index([country, eventAt])
  @@index([partnerId, eventAt])
  @@index([merchantPartnerId, eventAt])
}

model Invoice {
  id            String        @id @default(uuid())
  type          DocumentType
  // Assigned when issued: INV-EG-2026-000001, PAY-…, STM-…
  number        String?       @unique
  partnerId     String
  partner       Partner       @relation(fields: [partnerId], references: [id])
  country       Country
  currency      Currency
  periodStart   DateTime
  periodEnd     DateTime
  subtotalMinor BigInt
  vatBps        Int
  vatMinor      BigInt
  totalMinor    BigInt
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?
  dueAt         DateTime?
  paidAt        DateTime?
  paymentRef    String?
  voidReason    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines InvoiceLine[]

  @@index([partnerId, periodStart])
  @@index([status])
}

model InvoiceLine {
  id                    String           @id @default(uuid())
  invoiceId             String
  invoice               Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind                  DocumentLineKind
  campaignId            String
  campaignName          String
  // For OWED_BY_FUNDER lines: the funder. For FUNDED_SHARE lines: the merchant paid.
  counterpartyPartnerId String?
  counterpartyName      String?
  redemptionCount       Int
  grossMinor            BigInt
  reversedMinor         BigInt
  netMinor              BigInt
}

// Gap-free document numbers per prefix, country and year.
model DocumentSequence {
  prefix  String
  country Country
  year    Int
  value   Int     @default(0)

  @@id([prefix, country, year])
}

// VAT applied to INVOICE documents, per country. The latest rate valid at the period end applies.
model TaxRate {
  id        String   @id @default(uuid())
  country   Country
  rateBps   Int
  validFrom DateTime
  createdAt DateTime @default(now())

  @@unique([country, validFrom])
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String
  role        UserRole
  // Staff sign in with Google; set on first login.
  googleSub   String?   @unique
  // Set only for PARTNER_USER — scopes the partner portal.
  partnerId   String?
  partner     Partner?  @relation(fields: [partnerId], references: [id])
  locale      String    @default("en")
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  sessions Session[]
}

model Session {
  id        String   @id @default(uuid())
  // SHA-256 of the cookie token; the token itself is never stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Something operations should know about. `dedupeKey` makes each condition fire once.
model Alert {
  id             String        @id @default(uuid())
  type           String
  severity       AlertSeverity
  status         AlertStatus   @default(OPEN)
  title          String
  message        String
  dedupeKey      String        @unique
  campaignId     String?
  terminalId     String?
  data           Json?
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime      @default(now())

  @@index([status, createdAt])
}

// Runtime settings (kill switch, guardrails, alert thresholds), editable by admins.
model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}
