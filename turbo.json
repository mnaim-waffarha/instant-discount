{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DATABASE_URL", "REDIS_URL", "CARD_TOKEN_PEPPER", "SECRETS_ENCRYPTION_KEY"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "docs:check": {
      "dependsOn": ["^build"]
    }
  }
}
